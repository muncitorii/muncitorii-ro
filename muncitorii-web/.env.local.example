# Supabase — gasesti aceste valori in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase service role key — OBLIGATORIU pentru Sprint 1 (coordonare).
# Folosit server-side (niciodata expus la client) pentru: /cerere, /parteneri,
# /p/[token] (aprobari), /admin (tot CRUD-ul). Fara aceasta cheie, aplicatia
# afiseaza date seed/mock (vezi README-COORDONARE.md) si formularele publice
# arata o eroare clara in loc sa salveze silentios in gol.
# Gasesti valoarea in Supabase Dashboard > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Business Number (format: 40XXXXXXXXX, fara +, fara spatii)
NEXT_PUBLIC_WHATSAPP_NUMBER=40712345678

# Resend — opțional. Fara ea, cererile/aplicatiile se salveaza in Supabase
# normal, dar nu se mai trimite emailul de notificare catre echipa.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Muncitorii.ro <onboarding@resend.dev>
CONTACT_NOTIFY_EMAIL=contact@muncitorii.ro
